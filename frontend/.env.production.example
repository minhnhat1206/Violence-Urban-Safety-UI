# =============================================================================
# Frontend — Production Environment Variables (Vercel)
# Set these in Vercel Project Settings → Environment Variables
# DO NOT commit real values — this file is a template only
# =============================================================================

# Chatbot API on Oracle Cloud (with nginx reverse proxy + SSL)
VITE_API_BASE_URL=https://api.YOUR_DOMAIN.com

# App branding
VITE_APP_TITLE=Vigilance AI — Smart Security Monitoring

# Optional: Grafana public URL (for embedded dashboard links)
VITE_GRAFANA_URL=https://grafana.YOUR_DOMAIN.com

# Optional: Flink Web UI (internal — usually not exposed publicly)
# VITE_FLINK_URL=https://flink.YOUR_DOMAIN.com
